# A node simulated by KWOK. hack/e2e-test.sh replaces INDEX.
apiVersion: v1
kind: Node
metadata:
  name: kwok-node-INDEX
  annotations:
    kwok.x-k8s.io/node: fake
  labels:
    kubernetes.io/hostname: kwok-node-INDEX
    kubernetes.io/os: linux
    type: kwok
spec:
  taints:
  - key: kwok.x-k8s.io/node
    value: fake
    effect: NoSchedule
status:
  allocatable:
    cpu: "64"
    memory: 256Gi
    pods: "250"
  capacity:
    cpu: "64"
    memory: 256Gi
    pods: "250"
